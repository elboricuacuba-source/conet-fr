<Window x:Class="GNSPhoneBridge.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GNSPhoneBridge.Client"
        mc:Ignorable="d"
        Title="Conet FR" Height="600" Width="900"
        Icon="Assets/icon.ico"
        Background="#0B1220">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Conet FR" FontSize="22" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="StatusText" Text="  —  Esperando al teléfono..."
                       FontSize="14" Foreground="#9FB3C8" VerticalAlignment="Bottom" Margin="8,0,0,2" />
        </StackPanel>

        <!-- QR view -->
        <Grid x:Name="ScanPanel" Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="8" Padding="16" HorizontalAlignment="Center">
                    <Image x:Name="QrImage" Width="320" Height="320" />
                </Border>
                <TextBlock Text="Abre Conet FR en tu Android y toca &quot;Conectar con la PC&quot;"
                           Foreground="#9FB3C8" FontSize="14" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Connected view -->
        <Grid x:Name="BrowsePanel" Grid.Row="1" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <TextBlock Text="✅" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock x:Name="ConnectedText" Text="Conectado"
                           Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Se abrió la carpeta de tu teléfono en el Explorador de Windows. También queda un acceso directo en Documentos para volver a entrar sin escanear otra vez."
                           Foreground="#9FB3C8" FontSize="13" Margin="0,8,0,20"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="ReopenButton" Content="Abrir carpeta de nuevo" Padding="10,6"
                        Margin="0,0,0,8" Click="ReopenButton_Click" HorizontalAlignment="Center" />
                <Button x:Name="RescanButton" Content="Emparejar otro teléfono" Padding="10,6"
                        Click="RescanButton_Click" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
