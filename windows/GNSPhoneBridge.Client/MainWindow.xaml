<Window x:Class="GNSPhoneBridge.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GNSPhoneBridge.Client"
        mc:Ignorable="d"
        Title="Conet FR" Height="600" Width="900"
        Icon="Assets/icon.ico"
        Background="#0B1220">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Conet FR" FontSize="22" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="StatusText" Text="  —  Esperando al teléfono..."
                       FontSize="14" Foreground="#9FB3C8" VerticalAlignment="Bottom" Margin="8,0,0,2" />
        </StackPanel>

        <!-- QR view -->
        <Grid x:Name="ScanPanel" Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Margin="0,0,40,0">
                    <Border Background="White" CornerRadius="8" Padding="16" HorizontalAlignment="Center">
                        <Image x:Name="QrImage" Width="320" Height="320" />
                    </Border>
                    <TextBlock Text="Abre Conet FR en tu Android y toca &quot;Conectar con la PC&quot;"
                               Foreground="#9FB3C8" FontSize="14" Margin="0,16,0,0" MaxWidth="320"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
                        <Image x:Name="DownloadQrImage" Width="150" Height="150" />
                    </Border>
                    <TextBlock Text="¿No tienes la app?&#10;Escanea esto con la cámara&#10;para descargarla"
                               Foreground="#9FB3C8" FontSize="12" Margin="0,10,0,0" MaxWidth="150"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Connected view -->
        <Grid x:Name="BrowsePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BackButton" Content="⬅ Atrás" Padding="10,4" Click="BackButton_Click" />
                <TextBlock x:Name="PathText" Text="/" Foreground="White" FontSize="14"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <Button x:Name="ReopenButton" Content="Abrir en el Explorador" Padding="10,4"
                        Margin="16,0,0,0" Click="ReopenButton_Click" />
                <Button x:Name="RescanButton" Content="Emparejar otro teléfono" Padding="10,4"
                        Margin="8,0,0,0" Click="RescanButton_Click" />
            </StackPanel>

            <ListView x:Name="FileList" Grid.Row="1" MouseDoubleClick="FileList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="30" DisplayMemberBinding="{Binding Icon}" />
                        <GridViewColumn Header="Nombre" Width="420" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Tamaño" Width="100" DisplayMemberBinding="{Binding SizeDisplay}" />
                        <GridViewColumn Header="Modificado" Width="160" DisplayMemberBinding="{Binding Modified}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="2" Text="Doble clic en una carpeta para entrar, o en un archivo para abrirlo. &quot;Abrir en el Explorador&quot; sirve para arrastrar y soltar varios archivos a la vez."
                       Foreground="#9FB3C8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
